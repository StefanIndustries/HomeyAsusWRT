{
  "title": {
    "en": "An Ethernet port got connected",
    "nl": "Een ethernetpoort is verbonden"
  },
  "hint": {
    "en": "Checks on an interval if a cable was plugged into an Ethernet port",
    "nl": "Checkt op basis van een interval of er een kabel in een ethernetpoort is gestoken"
  },
  "args": [
    {
      "type": "device",
