    }
  ],
  "tokens": [
    {
      "type": "string",
      "name": "port",
      "title": { "en": "port", "nl": "poort" },
      "example": { "en": "LAN 1" }
    },
    {
      "type": "number",
      "name": "speed_mbps",
      "title": { "en": "speed (Mbit/s)", "nl": "snelheid (Mbit/s)" },
      "example": { "en": "1000" }
    }
  ]
}
